//- compileAndRun expecting: .success

fun test_concat_both_empty() {
  let a = UTF8Array()
  let b = UTF8Array()
  let c = a + b
  precondition(c.count() == 0)
}

fun test_concat_one_empty() {
  let a = "test".utf8
  let b = UTF8Array()
  let c = a.copy() + b.copy()
  precondition(c.count() == 4)
  precondition(c == "test".utf8)
  let d = b + a
  precondition(d.count() == 4)
  precondition(d == "test".utf8)
}

fun test_concat_both_full() {
  let a = "test123456789".utf8
  let b = "check23456789".utf8
  let c = a.copy() + b.copy()
  precondition(c.count() == 26)
  precondition(c == "test123456789check23456789".utf8)
  let d = b + a
  precondition(d.count() == 26)
  precondition(d == "check23456789test123456789".utf8)
}

public fun main() {
  test_concat_both_empty()
  test_concat_one_empty()
  test_concat_both_full()
}
